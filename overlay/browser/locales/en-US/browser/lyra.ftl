# Doorhanger shown when a page offers an OpenSearch engine that is not
# installed yet. $engine is the engine's display name.
lyra-search-offer-message = { $engine } offers a search engine you can install.
lyra-search-offer-add = Add Search Engine
lyra-search-offer-dismiss = Not Now

lyra-update-available = Lyra Browser { $version } is available. Signature checked.
lyra-update-hash = Artifact SHA-256 starts { $sha256 }
lyra-update-download = Open release
lyra-update-dismiss = Not now
