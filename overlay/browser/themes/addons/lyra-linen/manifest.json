{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "lyra-linen@lyrabrowser.com"
    }
  },
  "name": "Lyra Linen",
  "description": "Lyra linen chrome.",
  "author": "Lyra",
  "version": "1.0.0",
  "icons": {
    "32": "icon.svg"
  },
  "theme": {
