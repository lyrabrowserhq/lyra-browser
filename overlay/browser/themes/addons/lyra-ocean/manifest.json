{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "lyra-ocean@lyrabrowser.com"
    }
  },
  "name": "Lyra Ocean",
  "description": "Lyra ocean chrome.",
  "author": "Lyra",
  "version": "1.0.0",
